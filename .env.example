# Copie este arquivo para .env antes de usar o Docker Compose ou executar a API localmente.
# Valores abaixo são fictícios e servem apenas para desenvolvimento local.
POSTGRES_DB=restaurant_management
POSTGRES_USER=restaurant_dev
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_PORT=5432
API_PORT=8000

# URL usada quando a API é executada fora do Docker; no Compose, o host é substituído por "db".
DATABASE_URL=postgresql+psycopg://restaurant_dev:development-only-change-me@localhost:5432/restaurant_management
APP_NAME=Restaurant Management API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
