# Copie para .env e ajuste os valores antes de iniciar o PostgreSQL.
POSTGRES_DB=colonia_gaucha
POSTGRES_USER=colonia_gaucha
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Desenvolvimento: permite uma chave efêmera apenas para testes locais.
# Tokens são invalidados ao reiniciar a aplicação.
JWT_EPHEMERAL_DEV_KEY=true

# Em produção, configure JWT_PRIVATE_KEY e JWT_PUBLIC_KEY com PEM PKCS#8/X.509,
# não habilite JWT_EPHEMERAL_DEV_KEY e use HTTPS.
